<div class="input-group">
    <input id="@Id" type="@(visible ? "text" : "password")" class="form-control" value="@Value" @onchange="Changed" autocomplete="off" spellcheck="false" placeholder="@Placeholder" />
    <button type="button" class="btn btn-outline-secondary" @onclick="() => visible = !visible" aria-label="@(visible ? $"Hide {Label}" : $"Show {Label}")" aria-controls="@Id" aria-pressed="@(visible ? "true" : "false")"><i class="bi @(visible ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i></button>
</div>
@code {
    [Parameter] public string Id { get; set; } = "connection-string";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Label { get; set; } = "connection string";
    private bool visible;
    private Task Changed(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
