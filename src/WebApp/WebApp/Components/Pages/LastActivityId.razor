@page "/lastactivityid"
@inject LastActivityIdService LastActivityService
@inject ILogger<LastActivityId> Logger
@inject IJSRuntime JS
@inject ActiveRepositoryContext Context
@inject OperatorReportService Reports
@implements IDisposable
@using WebApp.Components

<PageTitle>LastActivityId Management</PageTitle>
<fieldset disabled="@(Context.Busy || !Context.Ready)">

<div class="sensenet-header mb-4">
    <div class="d-flex align-items-center mb-3">
        <i class="bi bi-clock-history me-3" aria-hidden="true"></i>
        <h1 class="mb-0">LastActivityId Management</h1>
    </div>
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>
        Read, compare or correct the stored activity number.
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body text-center">
        <div class="row">
            <div class="col-md-6 mb-2">
                <button class="btn btn-primary w-100" 
                        @onclick="GetLastActivityId" 
                        disabled="@(!IsValidPath)">
                    <i class="bi bi-search me-2"></i>
                    Get Index LastActivityId
                </button>
            </div>
            <div class="col-md-6 mb-2">
                <button class="btn btn-info w-100" 
                        @onclick="GetDatabaseLastActivityId" 
                        disabled="@(string.IsNullOrWhiteSpace(ConnectionString))">
                    <i class="bi bi-database me-2"></i>
                    Get Database LastActivityId
                </button>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-12">
                <button class="btn btn-success w-100" 
                        @onclick="CompareLastActivityIds" 
                        disabled="@(!CanCompare)">
                    <i class="bi bi-arrow-left-right me-2"></i>
                    Compare Index vs Database
                </button>
            </div>
        </div>
    </div>
</div>



@if (LastActivityInfo != null || Context.CanWrite)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                <i class="bi bi-info-circle me-2"></i>
                Index LastActivityId
            </h5>
            <p class="card-text">
                <strong>LastActivityId:</strong> @(LastActivityInfo?.LastActivityId.ToString() ?? "Not initialized")
            </p>

        </div>
    </div>
}

@if (DatabaseLastActivityId.HasValue)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                <i class="bi bi-database me-2"></i>
                Database LastActivityId
            </h5>
            <p class="card-text">
                <strong>IndexingActivityId:</strong> @DatabaseLastActivityId.Value
            </p>
        </div>
    </div>
}

@if (LastActivityComparison != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                <i class="bi bi-arrow-left-right me-2"></i>
                Index vs Database Comparison
            </h5>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="card-title">
                                <i class="bi bi-folder me-1"></i>
                                Index
                            </h6>
                            <p class="card-text display-6">
                                @(LastActivityComparison.IndexValue?.ToString() ?? "N/A")
                            </p>
                            @if (LastActivityComparison.IndexRetrievedAt.HasValue)
                            {
                                <small class="text-muted">Retrieved: @LastActivityComparison.IndexRetrievedAt.Value.ToString("HH:mm:ss")</small>
                            }
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h6 class="card-title">
                                <i class="bi bi-database me-1"></i>
                                Database
                            </h6>
                            <p class="card-text display-6">
                                @(LastActivityComparison.DatabaseValue?.ToString() ?? "N/A")
                            </p>
                            @if (LastActivityComparison.DatabaseRetrievedAt.HasValue)
                            {
                                <small class="text-muted">Retrieved: @LastActivityComparison.DatabaseRetrievedAt.Value.ToString("HH:mm:ss")</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row mt-3">
                <div class="col-12">
                    <div class="alert @(LastActivityComparison.IsMatch ? "alert-success" : "alert-warning") text-center">
                        <h5 class="mb-2">
                            <i class="bi @(LastActivityComparison.IsMatch ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                            @LastActivityComparison.Status
                        </h5>
                        @if (LastActivityComparison.HasBothValues)
                        {
                            @if (!LastActivityComparison.IsMatch)
                            {
                                <p class="mb-0">
                                    <strong>Difference:</strong> @LastActivityComparison.Difference activities
                                </p>
                                @if (LastActivityComparison.IndexValue > LastActivityComparison.DatabaseValue)
                                {
                                    <small class="text-muted">Index is ahead of database</small>
                                }
                                else
                                {
                                    <small class="text-muted">Database is ahead of index</small>
                                }
                            }
                            else
                            {
                                <p class="mb-0">Index and database are synchronized</p>
                            }
                        }
                        else
                        {
                            <p class="mb-0">Unable to compare - missing values</p>
                        }
                    </div>
                </div>
            </div>
            

        </div>
    </div>
}

@if (LastActivityInfo != null || Context.CanWrite)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Modify LastActivityId</h5>
            @if (!Context.CanWrite) { <p class="text-muted">Select a working copy using Prepare index source.</p> }
            <div class="mb-3">
                <label for="newId" class="form-label">New LastActivityId Value</label>
                <input type="number" class="form-control" id="newId" min="0" max="2147483647" @bind="NewId" @bind:event="oninput" />
            </div>
            <p class="small text-muted">A safety snapshot is created before each metadata change.</p>
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="offline" @bind="IsOffline">
                <label class="form-check-label" for="offline">Confirm metadata change on this working copy</label>
            </div>
            <button class="btn btn-warning me-2" @onclick="SetLastActivityId" disabled="@(!CanModify)">
                Set LastActivityId
            </button>
            <button class="btn btn-danger" @onclick="InitLastActivityId" disabled="@(!CanModify)">
                Initialize LastActivityId
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ErrorMessage
    </div>
}

</fieldset>
@code {
    private long _contextRevision;
    private void ContextChanged()
    {
        if (_contextRevision != Context.Revision) { _contextRevision = Context.Revision; _indexPath = Context.IndexPath; _connectionString = Context.Settings.ConnectionString; LastActivityInfo = null; DatabaseLastActivityId = null; LastActivityComparison = null; IsOffline = false; NewId = 0; ErrorMessage = null; _isValidPathCache = LastActivityService.ValidatePath(IndexPath); }
        _ = InvokeAsync(StateHasChanged);
    }
    public void Dispose() { Context.Changed -= ContextChanged; }
    private string _indexPath = SenseNetIndexTools.RuntimeSettings.Load().SourcePath ?? "";
    private string IndexPath
    {
        get => _indexPath;
        set
        {
            if (_indexPath != value)
            {
                _indexPath = value;
                _isValidPathCache = null;
                _isValidPathCache = LastActivityService.ValidatePath(value);
            }
        }
    }
    private string _connectionString = SenseNetIndexTools.RuntimeSettings.Load().ConnectionString;
    private string ConnectionString
    {
        get => _connectionString;
        set => _connectionString = value;
    }
    private string? BackupPath { get; set; } = SenseNetIndexTools.RuntimeSettings.Load().BackupDirectory;
    private bool IsOffline { get; set; }
    private long NewId { get; set; }
    private string? ErrorMessage { get; set; }
    private LastActivityInfo? LastActivityInfo { get; set; }
    private long? DatabaseLastActivityId { get; set; }
    private LastActivityIdComparison? LastActivityComparison { get; set; }
    private bool? _isValidPathCache;
    private bool IsValidPath => _isValidPathCache ?? false;
    private bool CanModify => IsValidPath && IsOffline && NewId >= 0 && NewId <= int.MaxValue && IsWritablePath && !Context.Busy;
    private bool IsWritablePath
    {
        get { try { if (Context.Source is not { } source) return false; Context.Workspace.RequireWorkingCopy(source); return true; } catch { return false; } }
    }
    private bool CanCompare => IsValidPath && !string.IsNullOrWhiteSpace(ConnectionString);

    protected override void OnInitialized()
    {
        Context.Changed += ContextChanged;
        _contextRevision = Context.Revision;
        _indexPath = Context.IndexPath;
        _connectionString = Context.Settings.ConnectionString;
        // Configured defaults bypass the input setter; validate before first render.
        _isValidPathCache = LastActivityService.ValidatePath(IndexPath);
    }

    private async Task GetLastActivityId()
    {
        try
        {
            using var operation = Context.BeginOperation();
            ErrorMessage = null;
            Logger.LogInformation("Attempting to get LastActivityId from {IndexPath}", IndexPath);
            
            if (!LastActivityService.ValidatePath(IndexPath))
            {
                ErrorMessage = $"The index directory does not exist: {IndexPath}";
                Logger.LogWarning("Index directory does not exist: {IndexPath}", IndexPath);
                return;
            }
            
            LastActivityInfo = await LastActivityService.GetLastActivityIdAsync(IndexPath);
            Logger.LogInformation("Successfully retrieved LastActivityId from {IndexPath}", IndexPath);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error getting LastActivityId: {ex.Message}";
            Logger.LogError(ex, "Error getting LastActivityId from {IndexPath}", IndexPath);
        }
    }

    private async Task GetDatabaseLastActivityId()
    {
        try
        {
            using var operation = Context.BeginOperation();
            ErrorMessage = null;
            Logger.LogInformation("Attempting to get LastActivityId from database");
            
            if (string.IsNullOrWhiteSpace(ConnectionString))
            {
                ErrorMessage = "Connection string is required for database operations";
                return;
            }
            
            DatabaseLastActivityId = await LastActivityService.GetLastActivityIdFromDatabaseAsync(ConnectionString);
            Logger.LogInformation("Successfully retrieved LastActivityId from database: {DatabaseLastActivityId}", DatabaseLastActivityId);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error getting LastActivityId from database: {ex.Message}";
            Logger.LogError(ex, "Error getting LastActivityId from database");
        }
    }

    private async Task CompareLastActivityIds()
    {
        try
        {
            using var operation = Context.BeginOperation();
            ErrorMessage = null;
            Logger.LogInformation("Comparing LastActivityId between index and database");
            
            if (!LastActivityService.ValidatePath(IndexPath))
            {
                ErrorMessage = $"The index directory does not exist: {IndexPath}";
                return;
            }
            
            if (string.IsNullOrWhiteSpace(ConnectionString))
            {
                ErrorMessage = "Connection string is required for comparison";
                return;
            }
            
            LastActivityComparison = await LastActivityService.CompareLastActivityIdAsync(IndexPath, ConnectionString);
            await Reports.SaveActionAsync("LastActivityId comparison", new { Index = LastActivityComparison.IndexValue, Database = LastActivityComparison.DatabaseValue, Match = LastActivityComparison.IsMatch });
            Logger.LogInformation("Successfully compared LastActivityId - Status: {Status}", LastActivityComparison.Status);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error comparing LastActivityId: {ex.Message}";
            Logger.LogError(ex, "Error comparing LastActivityId");
        }
    }

    private async Task SetLastActivityId()
    {
        try
        {
            using var operation = Context.BeginOperation();
            ErrorMessage = null;
            if (!IsWritablePath || !IsOffline || NewId < 0 || NewId > int.MaxValue) throw new InvalidOperationException("Select a working copy, enter a valid number and confirm the change.");
            await LastActivityService.SetLastActivityIdAsync(IndexPath, NewId, true, BackupPath);
            LastActivityInfo = await LastActivityService.GetLastActivityIdAsync(IndexPath);
            IsOffline = false; LastActivityComparison = null;
            await Reports.SaveActionAsync("LastActivityId correction", new { Value = NewId });
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error setting LastActivityId: {ex.Message}";
            Logger.LogError(ex, "Error setting LastActivityId to {NewId} in {IndexPath}", NewId, IndexPath);
        }
    }

    private async Task InitLastActivityId()
    {
        try
        {
            using var operation = Context.BeginOperation();
            ErrorMessage = null;
            if (!IsWritablePath || !IsOffline || NewId < 0 || NewId > int.MaxValue) throw new InvalidOperationException("Select a working copy, enter a valid number and confirm the change.");
            await LastActivityService.InitializeLastActivityIdAsync(IndexPath, NewId, true, BackupPath);
            LastActivityInfo = await LastActivityService.GetLastActivityIdAsync(IndexPath);
            IsOffline = false; LastActivityComparison = null;
            await Reports.SaveActionAsync("LastActivityId correction", new { Value = NewId });
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error initializing LastActivityId: {ex.Message}";
            Logger.LogError(ex, "Error initializing LastActivityId to {NewId} in {IndexPath}", NewId, IndexPath);
        }
    }

}
