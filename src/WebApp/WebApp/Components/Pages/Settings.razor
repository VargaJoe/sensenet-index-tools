@page "/settings"
@rendermode InteractiveServer
@inject ConfigurationService ConfigurationService
@inject IJSRuntime JSRuntime
@inject ILogger<Settings> Logger

<PageTitle>Settings & Configuration</PageTitle>

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Settings</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0">
                <i class="bi bi-gear-fill me-2"></i>Settings & Configuration
            </h1>
            <p class="text-muted">Manage saved configurations for quick access to frequently used settings.</p>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mb-4">
        <div class="col">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-circle me-2"></i>New Configuration
            </button>
            <button class="btn btn-outline-secondary ms-2" @onclick="RefreshConfigurations">
                <i class="bi bi-arrow-clockwise me-2"></i>Refresh
            </button>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="Search configurations..." 
                       @bind="searchTerm" @oninput="OnSearchInput">
            </div>
        </div>
        <div class="col-md-6">
            <div class="btn-group" role="group">
                <input type="radio" class="btn-check" name="filter" id="all" @onchange="@(() => SetFilter("all"))" checked="@(currentFilter == "all")">
                <label class="btn btn-outline-primary" for="all">All</label>
                
                <input type="radio" class="btn-check" name="filter" id="favorites" @onchange="@(() => SetFilter("favorites"))" checked="@(currentFilter == "favorites")">
                <label class="btn btn-outline-primary" for="favorites">Favorites</label>
                
                <input type="radio" class="btn-check" name="filter" id="recent" @onchange="@(() => SetFilter("recent"))" checked="@(currentFilter == "recent")">
                <label class="btn btn-outline-primary" for="recent">Recent</label>
            </div>
        </div>
    </div>

    <!-- Configurations List -->
    <div class="row">
        <div class="col">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading configurations...</p>
                </div>
            }
            else if (!filteredConfigurations.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="mt-3">No configurations found</h5>
                    <p class="text-muted">
                        @if (currentFilter == "all")
                        {
                            <text>Create your first configuration to get started.</text>
                        }
                        else if (currentFilter == "favorites")
                        {
                            <text>Mark configurations as favorites to see them here.</text>
                        }
                        else
                        {
                            <text>Recently used configurations will appear here.</text>
                        }
                    </p>
                    <button class="btn btn-primary" @onclick="ShowCreateModal">
                        <i class="bi bi-plus-circle me-2"></i>Create Configuration
                    </button>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var config in filteredConfigurations)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h6 class="card-title mb-0">
                                        @if (config.IsFavorite)
                                        {
                                            <i class="bi bi-star-fill text-warning me-2"></i>
                                        }
                                        @config.Name
                                    </h6>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary" 
                                                @onclick="@(() => EditConfiguration(config))" 
                                                title="Edit Configuration">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" 
                                                @onclick="@(() => ToggleFavorite(config))"
                                                title="@(config.IsFavorite ? "Remove from Favorites" : "Add to Favorites")">
                                            @if (config.IsFavorite)
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" 
                                                @onclick="@(() => DeleteConfiguration(config))"
                                                title="Delete Configuration">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(config.Description))
                                    {
                                        <p class="card-text text-muted small mb-3">@config.Description</p>
                                    }
                                    
                                    <div class="mb-2">
                                        @if (!string.IsNullOrEmpty(config.IndexPath))
                                        {
                                            <div class="mb-1">
                                                <i class="bi bi-folder text-primary me-2"></i>
                                                <small class="text-muted">Index:</small>
                                                <br>
                                                <small class="font-monospace">@TruncatePath(config.IndexPath)</small>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(config.ConnectionString))
                                        {
                                            <div class="mb-1">
                                                <i class="bi bi-database text-success me-2"></i>
                                                <small class="text-muted">Database:</small>
                                                <br>
                                                <small class="font-monospace">@TruncateConnectionString(config.ConnectionString)</small>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(config.RepositoryPath))
                                        {
                                            <div class="mb-1">
                                                <i class="bi bi-archive text-info me-2"></i>
                                                <small class="text-muted">Repository:</small>
                                                <br>
                                                <small class="font-monospace">@TruncatePath(config.RepositoryPath)</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="card-footer text-muted d-flex justify-content-between align-items-center">
                                    <small>
                                        @if (config.LastUsed.HasValue)
                                        {
                                            <text>Last used: @config.LastUsed.Value.ToString("MMM d, yyyy")</text>
                                        }
                                        else
                                        {
                                            <text>Never used</text>
                                        }
                                    </small>
                                    <small>
                                        Used @config.UsageCount time@(config.UsageCount != 1 ? "s" : "")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Create/Edit Configuration Modal -->
@if (showConfigurationModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show" style="display: block;" tabindex="-1" aria-hidden="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="configurationOptions" OnValidSubmit="SaveConfiguration">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">
                            @if (isEditMode)
                            {
                                <i class="bi bi-pencil me-2"></i><text>Edit Configuration</text>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle me-2"></i><text>New Configuration</text>
                            }
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseConfigurationModal"></button>
                    </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalMessage))
                    {
                        <div class="alert alert-@(modalMessageType) alert-dismissible fade show" role="alert">
                            @modalMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="configName" class="form-label">Configuration Name *</label>
                                <InputText id="configName" class="form-control" @bind-Value="configurationOptions.Name" 
                                          placeholder="Enter a descriptive name"/>
                                <ValidationMessage For="@(() => configurationOptions.Name)" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <div class="form-check mt-4">
                                    <InputCheckbox id="isFavorite" class="form-check-input" @bind-Value="configurationOptions.IsFavorite" />
                                    <label class="form-check-label" for="isFavorite">
                                        <i class="bi bi-star-fill text-warning me-1"></i>Mark as Favorite
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="configDescription" class="form-label">Description</label>
                        <InputTextArea id="configDescription" class="form-control" rows="2" @bind-Value="configurationOptions.Description" 
                                      placeholder="Optional description to help identify this configuration"/>
                        <ValidationMessage For="@(() => configurationOptions.Description)" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="configIndexPath" class="form-label">Index Path</label>
                        <InputText id="configIndexPath" class="form-control" @bind-Value="configurationOptions.IndexPath" 
                                  placeholder="Path to Lucene index directory"/>
                        <ValidationMessage For="@(() => configurationOptions.IndexPath)" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="configConnectionString" class="form-label">Connection String</label>
                        <InputTextArea id="configConnectionString" class="form-control" rows="2" @bind-Value="configurationOptions.ConnectionString" 
                                      placeholder="SQL Server connection string"/>
                        <ValidationMessage For="@(() => configurationOptions.ConnectionString)" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="configRepositoryPath" class="form-label">Repository Path</label>
                        <InputText id="configRepositoryPath" class="form-control" @bind-Value="configurationOptions.RepositoryPath" 
                                  placeholder="Repository path for content operations"/>
                        <ValidationMessage For="@(() => configurationOptions.RepositoryPath)" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="configOutputPath" class="form-label">Default Output Path</label>
                        <InputText id="configOutputPath" class="form-control" @bind-Value="configurationOptions.DefaultOutputPath" 
                                  placeholder="Default directory for saving reports"/>
                        <ValidationMessage For="@(() => configurationOptions.DefaultOutputPath)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        @if (isEditMode)
                        {
                            <text>Update Configuration</text>
                        }
                        else
                        {
                            <text>Create Configuration</text>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show" style="display: block;" tabindex="-1" aria-hidden="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
            <div class="modal-body">
                @if (configurationToDelete != null)
                {
                    <p>Are you sure you want to delete the configuration <strong>@configurationToDelete.Name</strong>?</p>
                    <p class="text-muted small">This action cannot be undone.</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Delete Configuration
                </button>
            </div>
        </div>
    </div>
</div>
}

@code {
    private List<SavedConfiguration> allConfigurations = new();
    private List<SavedConfiguration> filteredConfigurations = new();
    private ConfigurationOptions configurationOptions = new();
    private SavedConfiguration? editingConfiguration;
    private SavedConfiguration? configurationToDelete;
    
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool isEditMode = false;
    private bool showConfigurationModal = false;
    private bool showDeleteModal = false;
    
    private string searchTerm = "";
    private string currentFilter = "all";
    private string modalMessage = "";
    private string modalMessageType = "info";

    protected override async Task OnInitializedAsync()
    {
        await RefreshConfigurations();
    }

    private async Task RefreshConfigurations()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            allConfigurations = await ConfigurationService.GetAllConfigurationsAsync();
            await ApplyFilter();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading configurations");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilter()
    {
        try
        {
            var baseConfigurations = currentFilter switch
            {
                "favorites" => await ConfigurationService.GetFavoriteConfigurationsAsync(),
                "recent" => await ConfigurationService.GetRecentConfigurationsAsync(),
                _ => allConfigurations
            };

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.ToLowerInvariant();
                filteredConfigurations = baseConfigurations.Where(c =>
                    c.Name.ToLowerInvariant().Contains(term) ||
                    (c.Description?.ToLowerInvariant().Contains(term) ?? false)
                ).ToList();
            }
            else
            {
                filteredConfigurations = baseConfigurations;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error applying filter");
            filteredConfigurations = new();
        }
    }

    private async Task SetFilter(string filter)
    {
        currentFilter = filter;
        await ApplyFilter();
        StateHasChanged();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await ApplyFilter();
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        isEditMode = false;
        configurationOptions = new ConfigurationOptions();
        editingConfiguration = null;
        modalMessage = "";
        showConfigurationModal = true;
        StateHasChanged();
    }

    private void EditConfiguration(SavedConfiguration config)
    {
        isEditMode = true;
        editingConfiguration = config;
        configurationOptions = new ConfigurationOptions
        {
            Name = config.Name,
            Description = config.Description,
            IndexPath = config.IndexPath,
            ConnectionString = config.ConnectionString,
            RepositoryPath = config.RepositoryPath,
            DefaultOutputPath = config.DefaultOutputPath,
            IsFavorite = config.IsFavorite,
            Tags = new List<string>(config.Tags)
        };
        modalMessage = "";
        showConfigurationModal = true;
        StateHasChanged();
    }

    private void CloseConfigurationModal()
    {
        showConfigurationModal = false;
        modalMessage = "";
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        configurationToDelete = null;
        StateHasChanged();
    }

    private async Task SaveConfiguration()
    {
        isSaving = true;
        modalMessage = "";
        StateHasChanged();

        try
        {
            ConfigurationResult result;
            
            if (isEditMode && editingConfiguration != null)
            {
                result = await ConfigurationService.UpdateConfigurationAsync(editingConfiguration.Id, configurationOptions);
            }
            else
            {
                result = await ConfigurationService.CreateConfigurationAsync(configurationOptions);
            }

            if (result.Success)
            {
                showConfigurationModal = false;
                await RefreshConfigurations();
            }
            else
            {
                modalMessage = result.Message;
                modalMessageType = "danger";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving configuration");
            modalMessage = "An error occurred while saving the configuration.";
            modalMessageType = "danger";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void DeleteConfiguration(SavedConfiguration config)
    {
        configurationToDelete = config;
        showDeleteModal = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (configurationToDelete == null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            var result = await ConfigurationService.DeleteConfigurationAsync(configurationToDelete.Id);
            if (result.Success)
            {
                showDeleteModal = false;
                await RefreshConfigurations();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting configuration");
        }
        finally
        {
            isDeleting = false;
            configurationToDelete = null;
            StateHasChanged();
        }
    }

    private async Task ToggleFavorite(SavedConfiguration config)
    {
        try
        {
            var options = new ConfigurationOptions
            {
                Name = config.Name,
                Description = config.Description,
                IndexPath = config.IndexPath,
                ConnectionString = config.ConnectionString,
                RepositoryPath = config.RepositoryPath,
                DefaultOutputPath = config.DefaultOutputPath,
                IsFavorite = !config.IsFavorite,
                Tags = config.Tags
            };

            await ConfigurationService.UpdateConfigurationAsync(config.Id, options);
            await RefreshConfigurations();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling favorite status");
        }
    }

    private string TruncatePath(string? path, int maxLength = 30)
    {
        if (string.IsNullOrEmpty(path) || path.Length <= maxLength)
            return path ?? "";

        return "..." + path.Substring(path.Length - maxLength + 3);
    }

    private string TruncateConnectionString(string? connectionString, int maxLength = 40)
    {
        if (string.IsNullOrEmpty(connectionString) || connectionString.Length <= maxLength)
            return connectionString ?? "";

        // Try to show the Data Source part
        var parts = connectionString.Split(';');
        var dataSource = parts.FirstOrDefault(p => p.Trim().StartsWith("Data Source", StringComparison.OrdinalIgnoreCase));
        if (dataSource != null)
        {
            var serverName = dataSource.Split('=').LastOrDefault()?.Trim();
            if (!string.IsNullOrEmpty(serverName))
            {
                return serverName + "...";
            }
        }

        return connectionString.Substring(0, maxLength - 3) + "...";
    }
}
