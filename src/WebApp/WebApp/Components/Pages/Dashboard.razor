@page "/"
@page "/dashboard"
@inject ILogger<Dashboard> Logger
@inject ReportStorageService Reports
@inject ActiveRepositoryContext Context
@implements IDisposable

<PageTitle>Dashboard - SenseNet Index Tools</PageTitle>

<div class="sensenet-header mb-4">
    <div class="d-flex align-items-center mb-3">
        <i class="bi bi-speedometer2 me-3" aria-hidden="true"></i>
        <h1 class="mb-0">Dashboard</h1>
    </div>
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>
        Comprehensive toolkit for managing and maintaining SenseNet Lucene.NET indexes.
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-lightning-charge me-2"></i>
                    Quick Actions
                </h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-grid">
                            <a href="/lastactivityid" class="btn btn-primary btn-lg">
                                <i class="bi bi-clock-history me-2"></i>
                                LastActivityId Management
                            </a>
                        </div>
                        <small class="text-muted">Get, set, or initialize LastActivityId values</small>
                    </div>
                    <div class="col-md-6">
                        <div class="d-grid">
                            <a href="/validation" class="btn btn-outline-primary btn-lg">
                                <i class="bi bi-shield-check me-2"></i>
                                Index Validation
                            </a>
                        </div>
                        <small class="text-muted">Validate index structure and integrity</small>
                    </div>
                    <div class="col-md-6">
                        <div class="d-grid">
                            <a href="/subtree-check" class="btn btn-outline-primary btn-lg">
                                <i class="bi bi-diagram-3 me-2"></i>
                                Subtree Checking
                            </a>
                        </div>
                        <small class="text-muted">Check database-index synchronization for subtrees</small>
                    </div>
                    <div class="col-md-6">
                        <div class="d-grid">
                            <a href="/rebuild-index" class="btn btn-outline-success btn-lg">
                                <i class="bi bi-arrow-repeat me-2"></i>
                                Rebuild Index
                            </a>
                        </div>
                        <small class="text-muted">Rebuild index entries for missing content items</small>
                    </div>
                    <div class="col-md-6">
                        <div class="d-grid">
                            <a href="/operations" class="btn btn-outline-primary btn-lg">
                                <i class="bi bi-list-ul me-2"></i>
                                Operator workspace
                            </a>
                        </div>
                        <small class="text-muted">Prepare sources and run the guided workflow</small>
                    </div>
                    <div class="col-md-6">
                        <div class="d-grid">
                            <a href="/reports" class="btn btn-outline-info btn-lg">
                                <i class="bi bi-file-earmark-text me-2"></i>
                                Reports
                            </a>
                        </div>
                        <small class="text-muted">View, download, and manage saved reports</small>
                    </div>
                    <div class="col-md-6">
                        <div class="d-grid">
                            <a href="/settings" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-gear-fill me-2"></i>
                                Settings
                            </a>
                        </div>
                        <small class="text-muted">Manage saved configurations</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-info-circle me-2"></i>
                    Latest diagnostic
                </h5>
                @if (RecentReports.FirstOrDefault() is { } latest)
                {
                    <a href="@($"/reports/{latest.Id}")">@latest.Operation</a>
                    <p class="text-muted mb-0">@latest.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") · @latest.Status</p>
                }
                else { <p class="text-muted mb-0">No diagnostics have been recorded yet.</p> }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-clock-history me-2"></i>
                    Recent Reports
                </h5>
                @if (RecentReports.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var report in RecentReports)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-start">
                                <div class="ms-2 me-auto">
                                    <a class="fw-bold" href="@($"/reports/{report.Id}")">@report.Operation</a>
                                    <div class="small text-muted">@report.Timestamp.ToString("yyyy-MM-dd HH:mm")</div>
                                </div>
                                <span class="badge bg-@(report.Status == "Completed" ? "success" : "warning") rounded-pill">
                                    @report.Status
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No reports available yet.</p>
                    <p class="small">
                        Reports will appear here after running operations like LastActivityId management, 
                        index validation, or subtree checking.
                    </p>
                }
            </div>
        </div>

        <div class="card mt-4 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-gear me-2"></i>
                    Overview
                </h5>
                <ul class="list-unstyled">
                    <li class="d-flex justify-content-between">
                        <span>Saved reports</span>
                        <span>@reportCount</span>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span>Repository</span>
                        <span class="text-muted">@Context.Selection.Name</span>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span>Index source</span>
                        <span class="text-muted">@(Context.Source?.Kind.ToString() ?? "Not selected")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ReportSummary> RecentReports = new();
    private int reportCount;
    private void ContextChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Context.Changed -= ContextChanged;

    protected override async Task OnInitializedAsync()
    {
        Context.Changed += ContextChanged;
        reportCount = (await Reports.GetReportStatisticsAsync()).GetValueOrDefault("Total");
        var reports = await Reports.GetReportsAsync(new() { PageSize = 5 });
        RecentReports = reports.Take(5).Select(r => new ReportSummary { Id = r.Id, Operation = r.Name, Timestamp = r.CreatedAt.ToLocalTime(), Status = r.Success ? "Completed" : "Errors found" }).ToList();
    }

    private class ReportSummary
    {
        public string Id { get; set; } = "";
        public string Operation { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
        public string Status { get; set; } = string.Empty;
    }
}
