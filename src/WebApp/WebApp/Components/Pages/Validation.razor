@page "/validation"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using WebApp.Services
@using WebApp.Components
@using SenseNetIndexTools
@inject IndexValidationService ValidationService
@inject IJSRuntime JSRuntime
@inject ILogger<Validation> Logger
@rendermode InteractiveServer

<PageTitle>Index Validation</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mb-0">
                    <i class="bi bi-shield-check text-primary me-2"></i>
                    Index Validation
                </h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active">Validation</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Configuration Selector -->
            <ConfigurationSelector OnConfigurationApplied="OnConfigurationApplied" />
            
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-gear me-2"></i>
                        Validation Configuration
                    </h5>
                </div>
                <div class="card-body">
                    <EditForm Model="@validationOptions" OnValidSubmit="@ValidateIndex">
                        <DataAnnotationsValidator />

                        <!-- Index Path Selection -->
                        <div class="mb-3">
                            <label for="indexPath" class="form-label">
                                <i class="bi bi-folder me-1"></i>
                                Index Directory Path <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <InputText @bind-Value="validationOptions.IndexPath" 
                                          class="form-control" 
                                          id="indexPath" 
                                          placeholder="Select or enter index directory path..." />
                                <button type="button" 
                                        class="btn btn-outline-secondary" 
                                        @onclick="ShowFolderPicker"
                                        disabled="@isValidating">
                                    <i class="bi bi-folder2-open"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => validationOptions.IndexPath)" class="text-danger small" />
                            @if (!string.IsNullOrEmpty(pathValidationMessage))
                            {
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @pathValidationMessage
                                </div>
                            }
                        </div>

                        <!-- Validation Level -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-layers me-1"></i>
                                Validation Level
                            </label>
                            <div class="form-check">
                                <InputCheckbox @bind-Value="validationOptions.Detailed" 
                                              class="form-check-input" 
                                              id="detailedCheck" />
                                <label class="form-check-label" for="detailedCheck">
                                    Comprehensive checks (detailed validation)
                                </label>
                            </div>
                            <div class="small text-muted">
                                Enable for thorough index structure analysis and field validation
                            </div>
                        </div>

                        <!-- Report Configuration -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="reportFormat" class="form-label">
                                    <i class="bi bi-file-text me-1"></i>
                                    Report Format
                                </label>
                                <InputSelect @bind-Value="validationOptions.ReportFormat" 
                                           class="form-select" 
                                           id="reportFormat">
                                    <option value="summary">Summary</option>
                                    <option value="detailed">Detailed</option>
                                    <option value="full">Full</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label for="outputFormat" class="form-label">
                                    <i class="bi bi-filetype-txt me-1"></i>
                                    Output Format
                                </label>
                                <InputSelect @bind-Value="validationOptions.Format" 
                                           class="form-select" 
                                           id="outputFormat">
                                    <option value="md">Markdown</option>
                                    <option value="html">HTML</option>
                                </InputSelect>
                            </div>
                        </div>

                        <!-- Backup Options -->
                        <div class="mb-3">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="validationOptions.CreateBackup" 
                                              class="form-check-input" 
                                              id="backupCheck" />
                                <label class="form-check-label" for="backupCheck">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Create backup before validation
                                </label>
                            </div>
                            @if (validationOptions.CreateBackup)
                            {
                                <div class="mt-2">
                                    <label for="backupPath" class="form-label small">Backup Path (optional)</label>
                                    <InputText @bind-Value="validationOptions.BackupPath" 
                                              class="form-control" 
                                              id="backupPath" 
                                              placeholder="Leave empty for default backup location" />
                                </div>
                            }
                        </div>

                        <!-- Advanced Options -->
                        <div class="mb-3">
                            <button type="button" 
                                    class="btn btn-link p-0 text-decoration-none" 
                                    @onclick="ToggleAdvancedOptions">
                                <i class="bi @(showAdvancedOptions ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>
                                Advanced Options
                            </button>
                            
                            @if (showAdvancedOptions)
                            {
                                <div class="border rounded p-3 mt-2 bg-light">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="sampleSize" class="form-label">Sample Size</label>
                                            <InputNumber @bind-Value="validationOptions.SampleSize" 
                                                        class="form-control" 
                                                        id="sampleSize" 
                                                        placeholder="10" />
                                            <div class="small text-muted">Leave empty for full validation</div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="outputPath" class="form-label">Custom Output Path</label>
                                            <InputText @bind-Value="validationOptions.OutputPath" 
                                                      class="form-control" 
                                                      id="outputPath" 
                                                      placeholder="Auto-generated if empty" />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="requiredFields" class="form-label">Required Fields (JSON)</label>
                                        <InputTextArea @bind-Value="validationOptions.RequiredFields" 
                                                      class="form-control" 
                                                      id="requiredFields" 
                                                      rows="3"
                                                      placeholder='["Id", "Path", "Name"]' />
                                        <div class="small text-muted">JSON array of field names that must be present</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" 
                                    class="btn btn-primary" 
                                    disabled="@(isValidating || string.IsNullOrEmpty(validationOptions.IndexPath))">
                                @if (isValidating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Validating...</span>
                                }
                                else
                                {
                                    <i class="bi bi-play-fill me-2"></i>
                                    <span>Start Validation</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Validation Info
                    </h5>
                </div>
                <div class="card-body">
                    <h6>What does validation check?</h6>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-check-circle text-success me-2"></i>Index structure integrity</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Document field completeness</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Segment health analysis</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Required field verification</li>
                    </ul>
                    
                    <hr>
                    
                    <h6>Report Formats</h6>
                    <ul class="list-unstyled small">
                        <li><strong>Summary:</strong> Key metrics and issues</li>
                        <li><strong>Detailed:</strong> In-depth analysis</li>
                        <li><strong>Full:</strong> Complete diagnostic information</li>
                    </ul>
                </div>
            </div>

            @if (lastValidationResult != null)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-clock-history me-2"></i>
                            Last Validation
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            @if (lastValidationResult.Success)
                            {
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <span class="text-success">Completed Successfully</span>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger me-2"></i>
                                <span class="text-danger">Failed</span>
                            }
                        </div>
                        <div class="small text-muted">
                            <div><strong>Duration:</strong> @lastValidationResult.Duration.TotalSeconds.ToString("F1")s</div>
                            <div><strong>Path:</strong> @lastValidationResult.IndexPath</div>
                            @if (!string.IsNullOrEmpty(lastValidationResult.ReportPath))
                            {
                                <div class="mt-2">
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-primary" 
                                            @onclick="() => ViewReport(lastValidationResult)">
                                        <i class="bi bi-file-text me-1"></i>
                                        View Report
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Validation Progress -->
    @if (isValidating)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border text-primary me-3" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <div>
                                <h6 class="mb-1">Validating Index...</h6>
                                <div class="text-muted">This may take a few moments depending on index size.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Results Display -->
    @if (validationResult != null)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-file-text me-2"></i>
                            Validation Results
                        </h5>
                        <div>
                            @if (validationResult.Success)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Completed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Failed
                                </span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Index Path:</strong> @validationResult.IndexPath
                            </div>
                            <div class="col-md-3">
                                <strong>Duration:</strong> @validationResult.Duration.TotalSeconds.ToString("F1")s
                            </div>
                            <div class="col-md-3">
                                <strong>Format:</strong> @validationResult.Options?.Format?.ToUpper()
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(validationResult.Message))
                        {
                            <div class="alert @(validationResult.Success ? "alert-success" : "alert-danger") mb-3">
                                @validationResult.Message
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(validationResult.ReportContent))
                        {
                            <div class="border rounded p-3" style="max-height: 400px; overflow-y: auto;">
                                @if (validationResult.Options?.Format == "html")
                                {
                                    @((MarkupString)validationResult.ReportContent)
                                }
                                else
                                {
                                    <pre class="mb-0">@validationResult.ReportContent</pre>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(validationResult.ReportPath))
                        {
                            <div class="mt-3">
                                <button type="button" 
                                        class="btn btn-outline-primary" 
                                        @onclick="() => DownloadReport(validationResult)">
                                    <i class="bi bi-download me-2"></i>
                                    Download Report
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Folder Picker Modal -->
<ServerFolderPicker @bind-Show="showFolderPicker" 
                   OnSelected="OnFolderSelected" />

@code {
    private ValidationOptions validationOptions = new();
    private ValidationServiceResult? validationResult;
    private ValidationServiceResult? lastValidationResult;
    private bool isValidating = false;
    private bool showAdvancedOptions = false;
    private bool showFolderPicker = false;
    private string pathValidationMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Initialize with default values
        validationOptions = new ValidationOptions
        {
            Detailed = false,
            ReportFormat = "summary",
            Format = "md",
            CreateBackup = false,  // Index validation is read-only, no backup needed by default
            SampleSize = 10
        };

        await base.OnInitializedAsync();
    }

    private void ShowFolderPicker()
    {
        try
        {
            showFolderPicker = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error showing folder picker");
        }
    }

    private async Task OnFolderSelected(string selectedPath)
    {
        try
        {
            validationOptions.IndexPath = selectedPath;
            showFolderPicker = false;
            await ValidatePath();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling folder selection");
        }
    }

    private async Task ValidatePath()
    {
        if (string.IsNullOrWhiteSpace(validationOptions.IndexPath))
        {
            pathValidationMessage = string.Empty;
            return;
        }

        var isValid = ValidationService.ValidatePath(validationOptions.IndexPath);
        pathValidationMessage = isValid 
            ? "✅ Valid index directory" 
            : "❌ Directory not found or not accessible";

        await Task.CompletedTask;
    }

    private void ToggleAdvancedOptions()
    {
        showAdvancedOptions = !showAdvancedOptions;
    }

    private async Task ValidateIndex()
    {
        try
        {
            isValidating = true;
            validationResult = null;
            StateHasChanged();

            Logger.LogInformation("Starting validation for: {Path}", validationOptions.IndexPath);
            
            var result = await ValidationService.ValidateIndexAsync(validationOptions);
            
            validationResult = result;
            lastValidationResult = result;
            
            Logger.LogInformation("Validation completed. Success: {Success}", result.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during validation");
            validationResult = new ValidationServiceResult
            {
                IndexPath = validationOptions.IndexPath,
                Success = false,
                Message = $"Validation failed: {ex.Message}",
                StartTime = DateTime.UtcNow,
                EndTime = DateTime.UtcNow
            };
        }
        finally
        {
            isValidating = false;
            StateHasChanged();
        }
    }

    private async Task ViewReport(ValidationServiceResult result)
    {
        try
        {
            if (!string.IsNullOrEmpty(result.ReportPath) && File.Exists(result.ReportPath))
            {
                await JSRuntime.InvokeVoidAsync("window.open", $"data:text/plain;charset=utf-8,{Uri.EscapeDataString(result.ReportContent ?? "")}", "_blank");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error viewing report");
        }
    }

    private async Task DownloadReport(ValidationServiceResult result)
    {
        try
        {
            if (!string.IsNullOrEmpty(result.ReportContent))
            {
                var fileName = $"validation_report_{DateTime.Now:yyyyMMdd_HHmmss}.{result.Options?.Format ?? "txt"}";
                var content = result.ReportContent;
                var mimeType = result.Options?.Format == "html" ? "text/html" : "text/plain";
                
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, content, mimeType);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading report");
        }
    }

    private void OnConfigurationApplied(SavedConfiguration configuration)
    {
        try
        {
            // Apply configuration values to the validation options
            if (!string.IsNullOrEmpty(configuration.IndexPath))
            {
                validationOptions.IndexPath = configuration.IndexPath;
            }
            
            if (!string.IsNullOrEmpty(configuration.DefaultOutputPath))
            {
                validationOptions.OutputPath = configuration.DefaultOutputPath;
            }

            StateHasChanged();
            
            Logger.LogInformation("Applied configuration: {ConfigurationName}", configuration.Name);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error applying configuration");
        }
    }
}
