@page "/home"

<PageTitle>SenseNet Index Tools</PageTitle>

<div class="text-center">
    <div class="sensenet-header mb-4">
        <div class="d-flex align-items-center justify-content-center mb-3">
            <img src="_content/WebApp/images/sensenet-logo.png" alt="SenseNet Logo" height="60" class="me-3" />
            <h1 class="mb-0">SenseNet Index Maintenance Suite</h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title mb-4">Welcome to the Web Interface</h2>
                    <p class="card-text lead mb-4">
                        Manage and maintain your SenseNet Lucene.NET indexes through this 
                        easy-to-use web interface.
                    </p>
                    
                    <div class="d-grid gap-2 col-6 mx-auto">
                        <a href="/dashboard" class="btn btn-primary btn-lg">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Go to Dashboard
                        </a>
                        <a href="/lastactivityid" class="btn btn-outline-primary">
                            <i class="bi bi-clock-history me-2"></i>
                            LastActivityId Management
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
