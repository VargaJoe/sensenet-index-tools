@page "/reports"
@rendermode InteractiveServer
@inject ReportStorageService ReportService
@inject ConfigurationService ConfigService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ILogger<Reports> Logger

<div class="container-fluid mt-3">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">Reports</li>
                </ol>
            </nav>
            <h2><i class="bi bi-file-earmark-text me-2"></i>Report History</h2>
            <p class="text-muted">View, download, and manage saved reports from validation, subtree checking, and content listing operations.</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        @if (statistics != null)
        {
            <div class="col-md-2 col-6 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@statistics["Total"]</h5>
                        <p class="card-text small">Total Reports</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-6 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-success">@statistics["ValidationReports"]</h5>
                        <p class="card-text small">Validation</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-6 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-info">@statistics["SubtreeReports"]</h5>
                        <p class="card-text small">Subtree Check</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-6 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-warning">@statistics["Favorites"]</h5>
                        <p class="card-text small">Favorites</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-6 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-secondary">@statistics["LastWeek"]</h5>
                        <p class="card-text small">Last Week</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-6 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-dark">@statistics["LastMonth"]</h5>
                        <p class="card-text small">Last Month</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Search and Filter Controls -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-funnel me-2"></i>Search & Filter
                        <button class="btn btn-sm btn-outline-secondary ms-2" type="button" @onclick="ToggleAdvancedFilters">
                            @if (showAdvancedFilters)
                            {
                                <text><i class="bi bi-chevron-up"></i> Hide Advanced</text>
                            }
                            else
                            {
                                <text><i class="bi bi-chevron-down"></i> Show Advanced</text>
                            }
                        </button>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="searchTerm" class="form-label">Search</label>
                            <input type="text" class="form-control" id="searchTerm" @bind="filter.SearchTerm" 
                                   @bind:after="FilterReports" placeholder="Search by name or description">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="reportType" class="form-label">Report Type</label>
                            <select class="form-select" id="reportType" @bind="filter.ReportType" @bind:after="FilterReports">
                                <option value="">All Types</option>
                                <option value="validation">Validation</option>
                                <option value="subtree-check">Subtree Check</option>
                                <option value="content-listing">Content Listing</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="sortBy" class="form-label">Sort By</label>
                            <select class="form-select" id="sortBy" @bind="filter.SortBy" @bind:after="FilterReports">
                                <option value="CreatedAt">Created Date</option>
                                <option value="Name">Name</option>
                                <option value="Duration">Duration</option>
                                <option value="Size">File Size</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label d-block">&nbsp;</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="favoritesOnly" 
                                       @bind="filter.FavoritesOnly" @bind:after="FilterReports">
                                <label class="form-check-label" for="favoritesOnly">
                                    <i class="bi bi-star-fill text-warning"></i> Favorites Only
                                </label>
                            </div>
                        </div>
                    </div>

                    @if (showAdvancedFilters)
                    {
                        <div class="row border-top pt-3">
                            <div class="col-md-3 mb-3">
                                <label for="fromDate" class="form-label">From Date</label>
                                <input type="date" class="form-control" id="fromDate" 
                                       @bind="filter.FromDate" @bind:after="FilterReports">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="toDate" class="form-label">To Date</label>
                                <input type="date" class="form-control" id="toDate" 
                                       @bind="filter.ToDate" @bind:after="FilterReports">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="successFilter" class="form-label">Status</label>
                                <select class="form-select" id="successFilter" @bind="successFilterValue" @bind:after="UpdateSuccessFilter">
                                    <option value="">All</option>
                                    <option value="true">Success</option>
                                    <option value="false">Failed</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label d-block">&nbsp;</label>
                                <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                                    <i class="bi bi-x-circle me-1"></i>Clear Filters
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Reports List -->
    <div class="row">
        <div class="col-12">
            @if (isLoading)
            {
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading reports...</span>
                    </div>
                    <p class="mt-2">Loading reports...</p>
                </div>
            }
            else if (filteredReports.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    @if (allReports.Count == 0)
                    {
                        <text>No reports found. Reports will appear here after running validation, subtree checking, or content listing operations.</text>
                    }
                    else
                    {
                        <text>No reports match your search criteria. Try adjusting the filters above.</text>
                    }
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul me-2"></i>Reports (@filteredReports.Count)
                        </h5>
                        <div>
                            <button class="btn btn-sm btn-outline-primary" @onclick="RefreshReports">
                                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 25%">Name</th>
                                    <th style="width: 12%">Type</th>
                                    <th style="width: 10%">Status</th>
                                    <th style="width: 15%">Created</th>
                                    <th style="width: 8%">Duration</th>
                                    <th style="width: 8%">Size</th>
                                    <th style="width: 7%">Views</th>
                                    <th style="width: 15%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in filteredReports)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (report.IsFavorite)
                                                {
                                                    <i class="bi bi-star-fill text-warning me-2"></i>
                                                }
                                                <div>
                                                    <div class="fw-medium">@report.Name</div>
                                                    @if (!string.IsNullOrWhiteSpace(report.Description))
                                                    {
                                                        <small class="text-muted">@report.Description</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @GetTypeBadgeClass(report.ReportType)">
                                                @GetTypeDisplayName(report.ReportType)
                                            </span>
                                        </td>
                                        <td>
                                            @if (report.Success)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Success
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger" title="@report.ErrorMessage">
                                                    <i class="bi bi-x-circle me-1"></i>Failed
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div>@report.FormattedCreatedAt</div>
                                            @if (report.LastViewedAt.HasValue)
                                            {
                                                <small class="text-muted">Viewed: @report.LastViewedAt.Value.ToString("MM-dd HH:mm")</small>
                                            }
                                        </td>
                                        <td>@report.FormattedDuration</td>
                                        <td>@report.FormattedSize</td>
                                        <td>@report.ViewCount</td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-outline-primary" title="View Report" 
                                                        @onclick="() => ViewReport(report.Id)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button class="btn btn-outline-secondary" title="Download Report" 
                                                        @onclick="() => DownloadReport(report.Id)">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                                <button class="btn @(report.IsFavorite ? "btn-warning" : "btn-outline-warning")" 
                                                        title="@(report.IsFavorite ? "Remove from Favorites" : "Add to Favorites")"
                                                        @onclick="() => ToggleFavorite(report.Id)">
                                                    <i class="bi @(report.IsFavorite ? "bi-star-fill" : "bi-star")"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" title="Delete Report" 
                                                        @onclick="() => PrepareDeleteReport(report)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && reportToDelete != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Report</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the report <strong>@reportToDelete.Name</strong>?</p>
                    <p class="text-muted small">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteReport">
                        <i class="bi bi-trash me-1"></i>Delete Report
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StoredReport> allReports = new();
    private List<StoredReport> filteredReports = new();
    private Dictionary<string, int>? statistics;
    private ReportSearchFilter filter = new();
    private bool isLoading = true;
    private bool showAdvancedFilters = false;
    private string successFilterValue = "";

    // Delete modal state
    private bool showDeleteModal = false;
    private StoredReport? reportToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
        await LoadStatistics();
    }

    private async Task LoadReports()
    {
        isLoading = true;
        try
        {
            allReports = await ReportService.GetReportsAsync();
            filteredReports = allReports;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load reports");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            statistics = await ReportService.GetReportStatisticsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load statistics");
            statistics = new Dictionary<string, int>();
        }
    }

    private async Task FilterReports()
    {
        try
        {
            filteredReports = await ReportService.GetReportsAsync(filter);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to filter reports");
        }
    }

    private async Task RefreshReports()
    {
        await LoadReports();
        await LoadStatistics();
        await FilterReports();
    }

    private void ToggleAdvancedFilters()
    {
        showAdvancedFilters = !showAdvancedFilters;
    }

    private async Task UpdateSuccessFilter()
    {
        filter.Success = string.IsNullOrEmpty(successFilterValue) ? null : bool.Parse(successFilterValue);
        await FilterReports();
    }

    private async Task ClearFilters()
    {
        filter = new ReportSearchFilter();
        successFilterValue = "";
        await FilterReports();
    }

    private void ViewReport(string reportId)
    {
        // Navigate to report view page
        Navigation.NavigateTo($"/reports/{reportId}");
    }

    private async Task DownloadReport(string reportId)
    {
        try
        {
            var report = await ReportService.GetReportAsync(reportId);
            if (report != null)
            {
                var fileName = $"{report.Name.Replace(" ", "_")}_{report.CreatedAt:yyyyMMdd_HHmmss}.{report.Format}";
                var mimeType = report.Format == "html" ? "text/html" : "text/markdown";
                
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, report.Content, mimeType);
                Logger.LogInformation("Downloaded report: {ReportId}", reportId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download report: {ReportId}", reportId);
        }
    }

    private async Task ToggleFavorite(string reportId)
    {
        try
        {
            await ReportService.ToggleFavoriteAsync(reportId);
            await RefreshReports();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle favorite: {ReportId}", reportId);
        }
    }

    private void PrepareDeleteReport(StoredReport report)
    {
        reportToDelete = report;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        reportToDelete = null;
    }

    private async Task ConfirmDeleteReport()
    {
        if (reportToDelete != null)
        {
            try
            {
                await ReportService.DeleteReportAsync(reportToDelete.Id);
                Logger.LogInformation("Deleted report: {ReportId}", reportToDelete.Id);
                
                CloseDeleteModal();
                await RefreshReports();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to delete report: {ReportId}", reportToDelete.Id);
            }
        }
    }

    private string GetTypeBadgeClass(string reportType) => reportType switch
    {
        "validation" => "bg-success",
        "subtree-check" => "bg-info",
        "content-listing" => "bg-warning",
        _ => "bg-secondary"
    };

    private string GetTypeDisplayName(string reportType) => reportType switch
    {
        "validation" => "Validation",
        "subtree-check" => "Subtree Check",
        "content-listing" => "Content Listing",
        _ => "Unknown"
    };
}
